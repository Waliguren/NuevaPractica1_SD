            "public_dns": "ec2-54-196-144-151.compute-1.amazonaws.com",
            "public_ip": "54.196.144.151",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
                "tags": {},
                "tags_all": {},
                "throughput": 125,
                "volume_id": "vol-05d9d21acff221eb7",
                "volume_size": 8,
