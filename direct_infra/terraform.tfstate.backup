            "user_data": "#!/bin/bash\r\ndnf update -y\r\ndnf install -y python3 python3-pip git\r\n              \r\ncd /home/ec2-user\r\ngit clone https://github.com/waliguren/nuevapractica1_sd.git repo\r\nmv repo/archivosCliente ./\r\nrm -rf repo\r\n              \r\ncd archivosCliente\r\npython3 -m venv venv\r\nvenv/bin/pip install aiohttp uvloop redis\r\n              \r\necho \"export NGINX_HOST=32.199.159.15\" \u003e\u003e /home/ec2-user/.bashrc\r\necho \"export REDIS_HOST=172.31.20.87\" \u003e\u003e /home/ec2-user/.bashrc\r\n",
            "user_data_base64": null,
